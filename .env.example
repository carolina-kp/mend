# Which AI provider to use: gemini or ollama (Ollama for local development only)
LLM_PROVIDER=gemini
# Model name. Default gemini-3.5-flash-lite (fast, free tier) or e.g. llama3.2-vision (Ollama)
LLM_MODEL=gemini-3.5-flash-lite
# Free key from https://aistudio.google.com/apikey. Server only, never sent to the browser.
GEMINI_API_KEY=
# Optional: how long to wait for each Gemini attempt before showing the standard idea set, in ms (default 12000)
GEMINI_TIMEOUT_MS=12000
# Optional: Gemini thinking level: minimal (default, fastest), low, medium, high
GEMINI_THINKING=minimal
# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Feedback storage (Supabase free tier). Leave empty to store in data/events.jsonl locally.
# Run supabase/migrations/001_events.sql once in the Supabase SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared passcode for /lab (testing tools and CSV export). Lab is off when empty.
LAB_PASSCODE=

# Optional: email the team when a quote request comes in (Resend free tier, https://resend.com).
# Without these, requests are only stored and listed in /lab.
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=
# Sender address; the default works on Resend's free tier without a domain.
QUOTE_FROM_EMAIL=

# Optional: contact email shown on /privacy. Without it the page says to ask the team in person.
PRIVACY_CONTACT_EMAIL=
