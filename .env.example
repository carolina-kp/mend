# Which AI provider to use: gemini or ollama
LLM_PROVIDER=gemini
# Model name, e.g. gemini-3.5-flash (Gemini) or llava / llama3.2-vision (Ollama)
LLM_MODEL=
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
